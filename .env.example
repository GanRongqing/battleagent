# BattleAgent / Harness — environment template (NON-SENSITIVE)
#
# Copy to .env and fill in as needed. NEVER commit a real .env or any token.
# Defaults below reflect the verified local (single-host) runtime.

# --- Simulator backend ---
# Code default is a remote host; set 127.0.0.1 for local single-host runs.
SIM_HOST=127.0.0.1
SIM_PORT=6000
SIM_USER=admin

# --- POMDP API ---
API_HOST=
APP_PORT=8000
MACRO_STEP=30
LOG_LEVEL=INFO
ENABLE_DOCS=1
LANDING_RADIUS=5

# --- Scenario ---
SCENARIO_SCRIPT=scenario_composition

# --- LLM commander (optional; stable W5 runtime works with LLM_ENABLED=false) ---
LLM_ENABLED=false
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# Leave EMPTY. Provide at runtime via environment or a local secret store.
ANTHROPIC_AUTH_TOKEN=
