{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MechanismCard",
  "type": "object",
  "required": ["candidate_id", "parent_id", "status", "code", "failure", "root_cause", "mechanism",
               "applicability", "metrics", "validation", "limitations", "lessons", "next_questions"],
  "properties": {
    "candidate_id": {"type": "string"},
    "parent_id": {"type": "string"},
    "status": {"type": "string"},
    "created_at": {"type": "string"},
    "code": {
      "type": "object",
      "required": ["main_file", "sha256", "parent_sha256", "changed_files"],
      "properties": {
        "main_file": {"type": "string"},
        "sha256": {"type": "string"},
        "parent_sha256": {"type": "string"},
        "changed_files": {"type": "array", "items": {"type": "string"}},
        "changed_functions": {"type": "array", "items": {"type": "string"}},
        "diff_path": {"type": "string"}
      }
    },
    "failure": {"type": "object", "required": ["name"],
                "properties": {"name": {"type": "string"}, "description": {"type": "string"},
                               "evidence": {"type": "array", "items": {"type": "string"}}}},
    "root_cause": {"type": "object", "required": ["name"],
                   "properties": {"name": {"type": "string"}, "description": {"type": "string"},
                                  "confidence": {"type": "string"}}},
    "mechanism": {"type": "object", "required": ["name"],
                  "properties": {"name": {"type": "string"}, "summary": {"type": "string"},
                                 "trigger_condition": {"type": "string"},
                                 "behavior_change": {"type": "string"}, "scope": {"type": "string"}}},
    "applicability": {"type": "object",
                      "properties": {"required_conditions": {"type": "array", "items": {"type": "string"}},
                                     "known_non_applicable_conditions": {"type": "array", "items": {"type": "string"}}}},
    "metrics": {"type": "object",
                "properties": {"mechanism_metrics": {"type": "object"}, "combat_metrics": {"type": "object"}}},
    "validation": {"type": "object",
                   "properties": {"unit_tests": {"type": "string"}, "dev_status": {"type": "string"},
                                  "fresh_status": {"type": "string"}}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "lessons": {"type": "array", "items": {"type": "string"}},
    "next_questions": {"type": "array", "items": {"type": "string"}}
  }
}
